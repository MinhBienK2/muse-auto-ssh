[Unit]
Description=muse-bridge - watcher inbox cho Agent Ngoai (tu gui lai tin pending)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
#Sua duong dan repo neu ban move repo (xem LOCAL_AGENT.md muc 7.1)
WorkingDirectory=%h/Documents/muse
ExecStart=/bin/bash %h/Documents/muse/scripts/bridge.sh daemon 3
Restart=always
RestartSec=10

[Install]
WantedBy=default.target
